datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Vote {
  id        String   @id @default(uuid())
  type      String
  country   String?
  createdAt DateTime @default(now())
  ip        String?
}

model Visitor {
  id        String   @id @default(uuid())
  ip        String   @unique
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  name      String
  country   String?
  content   String
  createdAt DateTime @default(now())
}
